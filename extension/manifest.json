{
  "manifest_version": 3,
  "name": "OfflineVideo",
  "version": "0.3.10",
  "description": "Download videos from YouTube and other supported sites as MP4 files for offline viewing.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OfflineVideo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
